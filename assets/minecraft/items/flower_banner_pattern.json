{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "hanolter:secret_recipe_normal",
        "model": {
          "type": "minecraft:model",
          "model": "hanolter:item/secret_recipe_normal"
        }
      },
      {
        "when": "hanolter:secret_recipe_rare",
        "model": {
          "type": "minecraft:model",
          "model": "hanolter:item/secret_recipe_rare"
        }
      },
      {
        "when": "hanolter:secret_recipe_legend",
        "model": {
          "type": "minecraft:model",
          "model": "hanolter:item/secret_recipe_legend"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/flower_banner_pattern"
    }
  }
}
