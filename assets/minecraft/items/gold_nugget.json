{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "hanolter:gold_grain",
        "model": {
          "type": "minecraft:model",
          "model": "hanolter:item/gold_grain"
        }
      },
      {
        "when": "hanolter:relic_old_coin",
        "model": {
          "type": "minecraft:model",
          "model": "hanolter:item/relic_old_coin"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/gold_nugget"
    }
  }
}
